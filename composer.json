{
    "name": "sllhsmile/hyperf-log",
    "description": "Structured API, Redis, database and Guzzle logging for Hyperf.",
    "type": "library",
    "keywords": [
        "hyperf",
        "logging",
        "trace",
        "guzzle",
        "redis",
        "database"
    ],
    "homepage": "https://github.com/sllhSmile/hyperf-log",
    "license": "MIT",
    "authors": [
        {
            "name": "sllhSmile"
        }
    ],
    "support": {
        "issues": "https://github.com/sllhSmile/hyperf-log/issues",
        "source": "https://github.com/sllhSmile/hyperf-log"
    },
    "require": {
        "ext-swoole": ">=5.0",
        "php": ">=8.2",
        "guzzlehttp/guzzle": "^7.0",
        "guzzlehttp/promises": "^2.5",
        "hyperf/command": "^3.2",
        "hyperf/context": "^3.2",
        "hyperf/contract": "^3.2",
        "hyperf/coroutine": "^3.2",
        "hyperf/database": "^3.2",
        "hyperf/di": "^3.2",
        "hyperf/engine": "^2.14",
        "hyperf/event": "^3.2",
        "hyperf/framework": "^3.2",
        "hyperf/http-message": "^3.2",
        "hyperf/http-server": "^3.2",
        "hyperf/logger": "^3.2",
        "hyperf/redis": "^3.2",
        "hyperf/server": "^3.2",
        "monolog/monolog": "^3.1",
        "psr/http-message": "^1.0 || ^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "ramsey/uuid": "^4.7"
    },
    "autoload": {
        "psr-4": {
            "Sllhsmile\\HyperfLog\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sllhsmile\\HyperfLog\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.89",
        "hyperf/config": "^3.2",
        "nikic/php-parser": "^5.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.0"
    },
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "analyse": "phpstan analyse --memory-limit=-1",
        "benchmark": "php benchmark/collector.php",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "test": "phpunit -c phpunit.xml --colors=always",
        "check": [
            "@test",
            "@analyse",
            "@cs"
        ]
    },
    "extra": {
        "hyperf": {
            "config": "Sllhsmile\\HyperfLog\\ConfigProvider"
        }
    }
}
